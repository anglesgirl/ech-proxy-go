[
  {
    "id": 1,
    "priority": 1,
    "action": {
      "type": "redirect",
      "redirect": {
        "regexSubstitution": "https://abs.twimg.com/\\1"
      }
    },
    "condition": {
      "regexFilter": "^https://(?:abs-[0-9]|abs-o-ft|abs-o)\\.twimg\\.com/(.*)$",
      "resourceTypes": [
        "main_frame",
        "sub_frame",
        "stylesheet",
        "script",
        "image",
        "font",
        "object",
        "xmlhttprequest",
        "ping",
        "csp_report",
        "media",
        "websocket",
        "other"
      ]
    }
  }
]
