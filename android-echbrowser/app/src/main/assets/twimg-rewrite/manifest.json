{
  "manifest_version": 3,
  "name": "twimg-rewrite",
  "version": "1.1",
  "description": "把 CF 上不存在的 twimg 子域（abs-0 等）重写到 abs.twimg.com —— 内容实测等价（62 万字节仅差 40 字节 Sentry release id），避免明文 SNI 泄漏。",

  "browser_specific_settings": {
    "gecko": {
      "id": "twimg-rewrite@anglesgirl.local"
    }
  },

  "permissions": [
    "declarativeNetRequest"
  ],

  "host_permissions": [
    "*://*.twimg.com/*"
  ],

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "twimg-rewrite-rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
